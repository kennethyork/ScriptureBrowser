[Unit]
Description=Scripture Browser — re-vendor the clone after Firefox moves on
Documentation=file:__PREFIX__/README.md
After=local-fs.target
ConditionPathExists=__PREFIX__/install.sh

[Service]
Type=oneshot
# install.sh --sync does nothing at all when the clone is already current.
ExecStart=__PREFIX__/install.sh --sync
Nice=15
IOSchedulingClass=idle
